<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.nathanaelkane.gitchangedfilesintellijplugin</id>
    <name>Git Changed Files</name>
    <vendor>nathanaelkane</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.github.nathanaelkane.gitchangedfilesintellijplugin.services.GitChangedFilesService"/>
    </extensions>

    <actions>
        <!-- Shortcuts are intentionally unbound — assign them via Settings → Keymap. -->
        <action id="GitChangedFiles.ShowModified"
                class="com.github.nathanaelkane.gitchangedfilesintellijplugin.actions.ShowModifiedFilesAction"
                text="Show Modified Files"
                description="Navigate to a file changed since the last commit (staged or unstaged)"/>
        <action id="GitChangedFiles.ShowBranch"
                class="com.github.nathanaelkane.gitchangedfilesintellijplugin.actions.ShowBranchFilesAction"
                text="Show Branch Files"
                description="Navigate to a file changed on the current branch"/>
        <action id="GitChangedFiles.ShowBranchAndModified"
                class="com.github.nathanaelkane.gitchangedfilesintellijplugin.actions.ShowBranchAndModifiedFilesAction"
                text="Show Branch + Modified Files"
                description="Navigate to a file changed on the current branch or since the last commit"/>
    </actions>
</idea-plugin>
